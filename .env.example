# Copy to .env and fill in. Never commit the real .env.

# Supabase project (Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=

# Auth.js with Google sign-in (https://authjs.dev/getting-started/providers/google)
NEXTAUTH_URL=http://localhost:3000
# Any long random string, e.g. the output of: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Country list and flags for the guest profile (https://restcountries.com)
REST_COUNTRIES_API_KEY=
